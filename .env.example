# Banco Postgres. Na Vercel, a integração com o Neon (aba Storage) preenche sozinha.
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
# Senha para VER o site (passe para o time). Vazio = site aberto para qualquer um com o link.
APP_PASSWORD=
# Senha para EDITAR cargos e faixas (só para o RH). Vazio = a senha de ver também edita.
ADMIN_PASSWORD=
# Contato que aparece no rodapé ("Procure sua liderança ou o time de RH: ...")
CONTATO_RH=rh@matter.com.br
